YUKIT_ENVIRONMENT=local
YUKIT_PUBLIC_BASE_URL=http://localhost:5173
YUKIT_API_BASE_URL=http://localhost:8000/api
YUKIT_DATABASE_URL=postgresql+asyncpg://yukit:yukit@localhost:5432/yukit
YUKIT_REDIS_URL=redis://localhost:6379/0
YUKIT_SESSION_SECRET=local-dev-session-secret-change-me
YUKIT_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8080"]
YUKIT_DEV_AUTH_ENABLED=true
YUKIT_LOG_LEVEL=INFO
YUKIT_LOG_FORMAT=text
YUKIT_LOG_MAX_SIZE=10m
YUKIT_LOG_MAX_FILE=5
# Optional override. By default cookies are Secure when YUKIT_API_BASE_URL uses HTTPS.
# YUKIT_COOKIE_SECURE=false
# Optional outbound proxy for production API calls to providers such as GitHub.
# Use this when the server cannot reach GitHub directly, for example with v2rayA on host network.
# YUKIT_OUTBOUND_PROXY_URL=http://host.docker.internal:20171
# YUKIT_OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,redis,api,web,yukit-redis
YUKIT_GITHUB_CLIENT_ID=
YUKIT_GITHUB_CLIENT_SECRET=
YUKIT_SITE_ADDRESS=:80
YUKIT_HTTP_PORT=8080
YUKIT_HTTPS_PORT=8443
